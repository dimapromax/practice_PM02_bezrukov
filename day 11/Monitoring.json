{
  "dashboard": {
    "title": "Backup Monitoring Dashboard",
    "tags": ["backup", "mongodb", "redis", "disaster-recovery"],
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "title": "Backup Status (Last 24 hours)",
        "targets": [
          {
            "expr": "backup_status{job=\"mongodb_profiles\"}",
            "legendFormat": "{{job}}",
            "step": "10s"
          }
        ],
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0}
      },
      {
        "title": "Age of Last Backup (RPO Alert)",
        "targets": [
          {
            "expr": "time() - backup_last_timestamp{job=\"mongodb_profiles\"} > 300",
            "legendFormat": "RPO Exceeded"
          }
        ],
        "type": "alertlist",
        "gridPos": {"h": 4, "w": 8, "x": 4, "y": 0}
      },
      {
        "title": "Backup Size (GB)",
        "targets": [
          {
            "expr": "backup_size_bytes{job=\"mongodb_profiles\"} / 1024^3",
            "legendFormat": "{{job}}",
            "step": "1m"
          }
        ],
        "type": "graph",
        "gridPos": {"h": 6, "w": 8, "x": 0, "y": 4}
      },
      {
        "title": "Backup Duration (seconds)",
        "targets": [
          {
            "expr": "backup_duration_seconds{job=\"mongodb_profiles\"}",
            "legendFormat": "{{job}}",
            "step": "1m"
          }
        ],
        "type": "graph",
        "gridPos": {"h": 6, "w": 8, "x": 8, "y": 4}
      },
      {
        "title": "Free Space on Backup Server",
        "targets": [
          {
            "expr": "backup_free_space_gb{job=\"mongodb_profiles\"}",
            "legendFormat": "Free Space",
            "step": "1m"
          }
        ],
        "type": "gauge",
        "gridPos": {"h": 6, "w": 4, "x": 16, "y": 4}
      }
    ],
    "alerting": {
      "alertList": [
        {
          "alert": "BackupJobFailed",
          "expr": "backup_status{job=\"mongodb_profiles\"} == 0",
          "for": "5m",
          "labels": {"severity": "critical"},
          "annotations": {
            "summary": "Backup job failed for {{ $labels.job }}",
            "description": "MongoDB backup has been failing for more than 5 minutes."
          }
        },
        {
          "alert": "BackupTooOld",
          "expr": "time() - backup_last_timestamp{job=\"mongodb_profiles\"} > 600",
          "for": "5m",
          "labels": {"severity": "warning"},
          "annotations": {
            "summary": "Backup is older than RPO",
            "description": "Last successful backup was {{ $value }} seconds ago."
          }
        },
        {
          "alert": "DiskSpaceNearFull",
          "expr": "backup_free_space_gb{job=\"mongodb_profiles\"} < 50",
          "for": "10m",
          "labels": {"severity": "critical"},
          "annotations": {
            "summary": "Disk space is running low",
            "description": "Only {{ $value }} GB free."
          }
        }
      ]
    }
  }
}